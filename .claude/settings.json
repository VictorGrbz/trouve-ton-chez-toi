{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tsc-check.js",
            "timeout": 60,
            "statusMessage": "Vérification des types (tsc --noEmit)..."
          }
        ]
      }
    ]
  }
}
